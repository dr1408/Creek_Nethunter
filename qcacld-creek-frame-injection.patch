+	return QDF_STATUS_E_NOSUPPORT;
+}
+
+static inline QDF_STATUS hdd_reset_injection_stats(struct hdd_adapter *adapter)
+{
+	return QDF_STATUS_E_NOSUPPORT;
+}
+
+#endif /* FEATURE_FRAME_INJECTION_SUPPORT */
+
+#endif /* __WLAN_HDD_INJECT_SECURITY_H */
