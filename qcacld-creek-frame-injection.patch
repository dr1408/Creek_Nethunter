+	len += scnprintf(debug_buf + len, 1024 - len,
+			 "Max Frame Size:       %u bytes\n", config->max_frame_size);
+	len += scnprintf(debug_buf + len, 1024 - len,
+			 "Max Queue Size:       %u frames\n", config->max_queue_size);
+	len += scnprintf(debug_buf + len, 1024 - len,
