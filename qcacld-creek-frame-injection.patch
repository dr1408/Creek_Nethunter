diff --git a/qcacld-3.0/Kbuild b/qcacld-3.0/Kbuild
index ac1bffd..2a608a4 100644
--- a/qcacld-3.0/Kbuild
+++ b/qcacld-3.0/Kbuild
@@ -254,10 +254,21 @@ ifeq ($(CONFIG_WLAN_FEATURE_TWT), y)
